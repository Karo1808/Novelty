{
  "name": "@novelty/db",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist coverage"
  },
  "dependencies": {
    "@novelty/lib": "workspace:*",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "nanoid": "^5.1.5",
    "pg": "^8.16.2",
    "prom-client": "^15.1.3",
    "sha3": "^2.1.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.1",
    "@novelty/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.30.6",
    "testcontainers": "^10.28.0",
    "tsx": "^4.20.3",
    "typescript": "5.8.3"
  }
}
