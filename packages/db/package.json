{
  "name": "@novelty/db",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist coverage"
  },
  "dependencies": {
    "@novelty/lib": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "nanoid": "^5.0.9",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "sha3": "^2.1.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.2.0",
    "@novelty/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^10.18.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  }
}
