{
  "name": "@novelty/db",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "dev": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist coverage"
  },
  "dependencies": {
    "@novelty/lib": "workspace:*",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.4",
    "drizzle-zod": "^0.6.0",
    "nanoid": "^5.1.5",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "sha3": "^2.1.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@novelty/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^11.5.1",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.4",
    "testcontainers": "^11.5.1",
    "tsx": "^4.20.4",
    "typescript": "5.9.2"
  }
}
