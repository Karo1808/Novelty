{
  "name": "@novelty/services",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest",
    "test:debug": "vitest run --printConsoleTrace=true --silent=false",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@node-rs/argon2": "^2.0.2",
    "@novelty/db": "workspace:*",
    "@novelty/email": "workspace:*",
    "@novelty/lib": "workspace:*",
    "@novelty/message-queue": "workspace:*",
    "@novelty/redis": "workspace:*",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "arctic": "^3.7.0",
    "dotenv": "^16.5.0",
    "fetch-blob": "^4.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.1",
    "@novelty/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^11.5.1",
    "@testcontainers/redis": "^11.5.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/pg": "^8.15.4",
    "@types/redlock": "^4.0.7",
    "bullmq": "^5.58.0",
    "drizzle-orm": "^0.44.4",
    "ioredis": "^5.7.0",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "redlock": "5.0.0-beta.2",
    "testcontainers": "^11.5.1",
    "typescript": "5.9.2",
    "zod": "^4.1.5"
  }
}
