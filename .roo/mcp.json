{
  "mcpServers": {
    "redis": {
      "command": "npx",
      "args": ["@gongrzhe/server-redis-plus-mcp", "redis://localhost:6379"]
    },
    "redis-queue": {
      "command": "npx",
      "args": ["@gongrzhe/server-redis-plus-mcp", "redis://localhost:6380"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:password@localhost:5432/database"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    }
  }
}
