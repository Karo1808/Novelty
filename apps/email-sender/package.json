{
  "name": "@novelty/worker-email-sender",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./email-sender.handler.tsx": {
      "import": {
        "types": "./dist/rpc.d.ts",
        "default": "./dist/rpc.js"
      }
    }
  },
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch ./index.ts",
    "start": "ts-node ./dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf node_modules .turbo dist coverage"
  },
  "dependencies": {
    "@novelty/email": "workspace:*",
    "@novelty/lib": "workspace:*",
    "@novelty/message-queue": "workspace:*",
    "bullmq": "^5.48.1",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^12.0.1",
    "prom-client": "^15.1.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@novelty/typescript-config": "workspace:*",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsx": "^4.19.3",
    "typescript": "5.8.3"
  }
}
