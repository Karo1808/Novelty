{
  "name": "@novelty/api",
  "type": "module",
  "version": "0.0.1",
  "private": "true",
  "exports": {
    "./rpc": {
      "import": {
        "types": "./dist/rpc.d.ts",
        "default": "./dist/rpc.js"
      }
    }
  },
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "ts-node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "npm run lint --fix",
    "build": "tspc && tsc-alias --resolve-full-paths pnpm build:rpc && pnpm sentry:sourcemaps",
    "build:rpc": "tspc -p tsconfig.rpc.json",
    "test": "cross-env NODE_ENV=test vitest",
    "test:debug": "cross-env NODE_ENV=test vitest run --printConsoleTrace=true --silent=false",
    "test:ci": "cross-env NODE_ENV=test vitest run",
    "test:ui": "cross-env NODE_ENV=test vitest --ui",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist coverage",
    "open-api:generate": "IS_OPEN_API_GENERATE=1 tsx ./src/lib/generate-open-api-spec.ts",
    "open-api:lint": "pnpm dlx @superfaceai/openapi-linter lint ./open-api-spec.yaml",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org karol-pietrucha --project novelty-api ./dist && sentry-cli sourcemaps upload --org karol-pietrucha --project novelty-api ./dist"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@hono/node-server": "^1.14.1",
    "@hono/prometheus": "^1.0.1",
    "@hono/sentry": "^1.2.1",
    "@hono/zod-openapi": "^0.19.4",
    "@novelty/db": "workspace:*",
    "@novelty/email": "workspace:*",
    "@novelty/lib": "workspace:*",
    "@novelty/message-queue": "workspace:*",
    "@novelty/redis": "workspace:*",
    "@novelty/services": "workspace:*",
    "@scalar/hono-api-reference": "^0.8.1",
    "@sentry/cli": "^2.43.0",
    "@sentry/node": "^9.22.0",
    "@sentry/profiling-node": "^9.12.0",
    "@types/pg": "^8.11.13",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^12.0.1",
    "hono": "^4.7.6",
    "hono-pino": "^0.8.0",
    "hono-rate-limiter": "^0.4.2",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-loki": "^2.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "redlock": "5.0.0-beta.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@novelty/typescript-config": "workspace:*",
    "@sentry/core": "^9.12.0",
    "@sentry/types": "^9.12.0",
    "@testcontainers/postgresql": "^10.24.2",
    "@testcontainers/redis": "^10.24.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "bullmq": "^5.48.1",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.41.0",
    "fetch-blob": "^4.0.0",
    "ioredis": "^5.6.1",
    "pg": "^8.14.1",
    "testcontainers": "^10.24.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.15",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.3",
    "typescript": "5.8.3",
    "typescript-transform-paths": "^3.5.5"
  }
}
