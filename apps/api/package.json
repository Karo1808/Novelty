{
  "name": "@novelty/api",
  "type": "module",
  "version": "0.0.1",
  "private": "true",
  "exports": {
    "./rpc": {
      "import": {
        "types": "./dist/rpc.d.ts",
        "default": "./dist/rpc.js"
      }
    }
  },
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "npm run lint --fix",
    "build": "tsc && pnpm build:rpc",
    "build:rpc": "tsc -p tsconfig.rpc.json",
    "test": "cross-env NODE_ENV=test vitest",
    "test:ci": "cross-env NODE_ENV=test vitest run",
    "test:ui": "cross-env NODE_ENV=test vitest --ui",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-openapi": "^0.17.0",
    "@logtail/pino": "^0.5.2",
    "@novelty/lib": "workspace:*",
    "@scalar/hono-api-reference": "^0.5.159",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^12.0.1",
    "hono": "^4.6.10",
    "hono-pino": "^0.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.9.2",
    "@novelty/typescript-config": "workspace:*",
    "@types/node": "^20.11.17",
    "cross-env": "^7.0.3",
    "tsx": "^4.7.1",
    "typescript": "5.5.4",
    "vitest": "^2.1.5"
  }
}
