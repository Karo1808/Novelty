{
  "name": "@novelty/api",
  "type": "module",
  "version": "0.0.1",
  "private": "true",
  "exports": {
    "./rpc": {
      "import": {
        "types": "./dist/rpc.d.ts",
        "default": "./dist/rpc.js"
      }
    }
  },
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "ts-node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "npm run lint --fix",
    "build": "tspc && tsc-alias --resolve-full-paths pnpm build:rpc && pnpm sentry:sourcemaps",
    "build:rpc": "tspc -p tsconfig.rpc.json",
    "test": "cross-env NODE_ENV=test vitest",
    "test:ci": "cross-env NODE_ENV=test vitest run",
    "test:ui": "cross-env NODE_ENV=test vitest --ui",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "clean": "rm -rf node_modules .turbo dist coverage",
    "open-api:generate": "IS_OPEN_API_GENERATE=1 tsx ./src/lib/generate-open-api-spec.ts",
    "open-api:lint": "pnpm dlx @superfaceai/openapi-linter lint ./open-api-spec.yaml",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org karol-pietrucha --project novelty-api ./dist && sentry-cli sourcemaps upload --org karol-pietrucha --project novelty-api ./dist"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@hono/node-server": "^1.13.8",
    "@hono/prometheus": "^1.0.1",
    "@hono/sentry": "^1.2.0",
    "@hono/zod-openapi": "^0.18.4",
    "@novelty/db": "workspace:*",
    "@novelty/email": "workspace:*",
    "@novelty/lib": "workspace:*",
    "@novelty/message-queue": "workspace:*",
    "@novelty/redis": "workspace:*",
    "@novelty/services": "workspace:*",
    "@scalar/hono-api-reference": "^0.5.172",
    "@sentry/cli": "^2.41.1",
    "@sentry/node": "^8.54.0",
    "@sentry/profiling-node": "^8.54.0",
    "@types/pg": "^8.11.11",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "hono": "^4.7.0",
    "hono-pino": "^0.7.2",
    "hono-rate-limiter": "^0.4.2",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0",
    "pino-loki": "^2.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.2.0",
    "@novelty/typescript-config": "workspace:*",
    "@sentry/types": "^8.54.0",
    "@testcontainers/postgresql": "^10.18.0",
    "@testcontainers/redis": "^10.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.39.3",
    "ioredis": "^5.5.0",
    "pg": "^8.13.1",
    "testcontainers": "^10.18.0",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3",
    "typescript-transform-paths": "^3.5.3"
  }
}
