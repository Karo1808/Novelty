{
  "extends": "@novelty/typescript-config/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./src/*"],
      "$/*": ["./src/modules/*"]
    },
    "types": ["node"],
    "outDir": "dist"
  },
  "include": ["src"]
}
