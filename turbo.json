{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "./dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint"]
    },
    "format": {},
    "typecheck": {},
    "clean": {
      "cache": false
    },
    "test": {},
    "test:ci": {},
    "test:ui": {},
    "test:coverage": {},
    "open-api:generate": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["open-api-spec.yaml"]
    },
    "open-api:lint": {
      "dependsOn": ["^open-api:generate"]
    },
    "compose:dev:up": {},
    "compose:dev:down": {},
    "compose:prod:up": {},
    "compose:prod:down": {}
  }
}
