{
  "name": "novelty",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "test:ui": "turbo test:ui",
    "test:coverage": "turbo test:coverage",
    "open-open-api:generate": "turbo open-api:generate",
    "open-open-api:lint": "turbo open-api:lint",
    "prepare": "husky",
    "commit": "git-cz",
    "compose:dev:up": "docker/run.sh dev",
    "compose:dev:down": "docker/stop.sh dev",
    "compose:prod:up": "docker/run.sh prod",
    "compose:prod:down": "docker/stop.sh prod"
  },
  "dependencies": {
    "eslint-config-turbo": "^2.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.0",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/cz-commitlint": "^19.5.0",
    "@commitlint/types": "^19.5.0",
    "@vitest/coverage-v8": "^2.1.6",
    "commitizen": "^4.3.1",
    "eslint": "^9.15.0",
    "eslint-plugin-format": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "turbo": "^2.3.3",
    "typescript": "5.5.4",
    "vite-tsconfig-paths": "^5.1.3",
    "vitest": "^2.1.6"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "lint-staged": {
    "(apps|packages)/**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
