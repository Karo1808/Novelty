{
  "name": "novelty",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo build",
    "build:rpc": "turbo build:rpc",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "test": "turbo test",
    "test:ci": "turbo test:ci",
    "test:ui": "turbo test:ui",
    "test:coverage": "turbo test:coverage",
    "open-open-api:generate": "turbo open-api:generate",
    "open-open-api:lint": "turbo open-api:lint",
    "prepare": "husky",
    "commit": "git-cz",
    "compose:dev:up": "docker/run.sh dev",
    "compose:dev:down": "docker/stop.sh dev",
    "compose:prod:up": "docker/run.sh prod",
    "compose:prod:down": "docker/stop.sh prod",
    "db:push": "turbo db:push",
    "db:studio": "turbo db:studio",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate"
  },
  "dependencies": {
    "eslint-plugin-drizzle": "^0.2.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/cz-commitlint": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@vitest/coverage-v8": "^3.1.1",
    "commitizen": "^4.3.1",
    "eslint": "^9.29.0",
    "eslint-config-turbo": "^2.5.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-oxlint": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "oxlint": "^1.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "lint-staged": {
    "(apps|packages)/**/*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
